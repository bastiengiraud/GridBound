# RL agent: training scripts, Julia environment, full SB3 checkpoint, notes ...
/wscc9_maskableppo_policy_extraction/*
# ... except what the case study needs: the network data, the actor weights and the SB3 'data' file
!/wscc9_maskableppo_policy_extraction/WSCC_9_bus.raw
!/wscc9_maskableppo_policy_extraction/extracted/
/wscc9_maskableppo_policy_extraction/extracted/*
!/wscc9_maskableppo_policy_extraction/extracted/wscc9_maskableppo_weights.npz
!/wscc9_maskableppo_policy_extraction/original_files/
/wscc9_maskableppo_policy_extraction/original_files/*
!/wscc9_maskableppo_policy_extraction/original_files/data

